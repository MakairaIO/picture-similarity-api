PHPINI_XDEBUG__REMOTE_ENABLE=1
PHPINI_XDEBUG__REMOTE_CONNECT_BACK=1
PHPINI_XDEBUG__REMOTE_AUTOSTART=1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

