USER_UID=1000
USER_GID=1000
WWW_USER=duong
WWW_GROUP=duong

PHP_IMAGE_VERSION=2
APP_DATA=/var/www/html/var
WEB_PORT=80
WEB_ROOT=/var/www/html/public
